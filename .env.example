# ==================================================
# FikaBoda Environment Variables (.env.example)
# Copy to .env for local development or configure in Firebase Functions / Cloud Run Secrets.
# NEVER commit real secrets to version control.
# ==================================================

# App URL (Injected automatically in AI Studio / Cloud Run)
APP_URL="http://localhost:3000"

# Gemini API Key (Optional server-side AI features if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --------------------------------------------------
# Client-Side Firebase Web Config (Public Identifiers)
# Note: AI Studio also provisions firebase-applet-config.json
# --------------------------------------------------
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-web-app-id"
VITE_FIREBASE_VAPID_KEY="your-fcm-web-push-vapid-key"
VITE_FIREBASE_APPCHECK_SITE_KEY="your-recaptcha-v3-site-key"

# --------------------------------------------------
# Google Maps Platform (Browser Key - Restrict to HTTP Referrers)
# --------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY="your-browser-restricted-maps-api-key"

# Server-Side Google Maps Key (Restricted to Routes/Geocoding IPs if proxy used)
GOOGLE_MAPS_SERVER_API_KEY="your-server-restricted-maps-api-key"

# --------------------------------------------------
# Safaricom Daraja M-Pesa API (SERVER-SIDE SECRETS ONLY)
# Never prefix these with VITE_
# --------------------------------------------------
DARAJA_ENV="sandbox"
DARAJA_CONSUMER_KEY="your-daraja-consumer-key"
DARAJA_CONSUMER_SECRET="your-daraja-consumer-secret"
DARAJA_SHORTCODE="174379"
DARAJA_PASSKEY="your-daraja-lipa-na-mpesa-passkey"
DARAJA_CALLBACK_URL="https://your-domain.com/api/mpesa/callback"
DARAJA_CALLBACK_SECRET="your-optional-callback-hmac-token"

# --------------------------------------------------
# Notification Provider Credentials (SERVER-SIDE SECRETS ONLY)
# --------------------------------------------------
WHATSAPP_ACCESS_TOKEN="your-meta-whatsapp-cloud-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-business-phone-number-id"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="your-africastalking-api-key"
AFRICASTALKING_SENDER_ID="FIKABODA"
